# Copy to .env and fill in. .env is gitignored and never read by Claude Code.
# Paid calls also need a budget in config/budgets.yaml and a run with --approve.

# DeepSeek (cloud tier / judge, family: deepseek). OpenAI-compatible API.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com

# GLM via Z.ai (family: zhipu). Pay-as-you-go API key ONLY: a GLM Coding Plan key may
# only be used in officially supported coding tools (docs.z.ai/devpack/usage-policy).
# General endpoint: https://api.z.ai/api/paas/v4
GLM_API_KEY=
GLM_BASE_URL=

# Real local models instead of the mocks (README step 8). Read only by commands run with
# `uv run --env-file .env ...`; commented out so tests and plain runs stay on the mocks.
# REFDESK_GENERATOR_TIER=local-small
# REFDESK_JUDGE_TIER=auto

# Local services
OLLAMA_BASE_URL=http://127.0.0.1:11434
KEV_BASE_URL=http://127.0.0.1:8009
# Optional. The local Kev server binds to 127.0.0.1 and is open by default; leave
# blank. Needed only for a Modal-deployed endpoint (public, Bearer auth required).
KEV_API_KEY=

# Modal (Kev training fallback only)
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=
