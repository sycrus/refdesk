# Copy to .env and fill in. .env is gitignored and never read by Claude Code.
# Paid calls also need a budget in config/budgets.yaml and a run with --approve.

# DeepSeek (cloud tier / judge, family: deepseek). OpenAI-compatible API.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com

# GLM via Z.ai (cloud tier / judge, family: zhipu)
GLM_API_KEY=
GLM_BASE_URL=

# Local services
OLLAMA_BASE_URL=http://127.0.0.1:11434
KEV_BASE_URL=http://127.0.0.1:8009
KEV_API_KEY=

# Modal (Kev training fallback only)
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=
